{
  "name": "ambition-news-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Ambition News Portal - Chhattisgarh & Madhya Pradesh Hyperlocal News PWA",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
